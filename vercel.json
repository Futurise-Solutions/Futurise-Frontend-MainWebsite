{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "trailingSlash": false,

  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "futurisesolutions.com"
        }
      ],
      "destination": "https://www.futurisesolutions.com/$1",
      "permanent": true
    },
    {
      "source": "/About",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/llms",
      "destination": "/llms.txt",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/futurise-admin/:path*",
      "destination": "/index.html"
    }
  ]
}