{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "installCommand": "dnf install -y nss nss-util nspr mesa-libgbm && npm install",

  "trailingSlash": false,

  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "futurisesolutions.com"
        }
      ],
      "destination": "https://www.futurisesolutions.com/$1",
      "permanent": true
    },
    {
      "source": "/About",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/llms",
      "destination": "/llms.txt",
      "permanent": true
    }
  ],

  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/case-studies", "destination": "/index.html" },
    { "source": "/case-studies/:slug", "destination": "/index.html" },
    { "source": "/service/:slug", "destination": "/index.html" },
    { "source": "/futurise-admin/:path*", "destination": "/index.html" }
  ]
}
