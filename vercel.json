{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.futurisesolutions.com" }],
      "destination": "https://futurisesolutions.com/$1",
      "permanent": true
    },
    {
      "source": "/About",
      "destination": "/about",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
