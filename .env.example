# Copy to .env for local development, and set the same keys in the Vercel project
# environment for deployments.
#
# Two kinds of variable live here, and the difference matters:
#
#   VITE_*      inlined into the client bundle at build time -> PUBLIC. Never a secret.
#   everything  read only by the serverless functions in api/ -> stays on the server.
#   else

# ---- Public (client) -------------------------------------------------------------
# Blog backend API base URL. Read by the browser bundle (src/config.js), the Edge
# middleware and the build's prerender step, so one value keeps all three in agreement.
#
# MUST BE AN ORIGIN ONLY — scheme + host, no path and no trailing slash:
#   good: https://your-backend.example.com
#   bad:  https://your-backend.example.com/api/blogs
# Callers append their own "/api/blogs/..." paths. A value carrying that suffix produces
# "/api/blogs/api/blogs/..." and a 404, which reads as "no posts" rather than as an error.
#
# Must be https in production: the site is served over https and a http:// API would be
# blocked as mixed content.
VITE_API_BASE_URL=

# ---- Server only (never exposed to the browser) ----------------------------------
# Password for the admin blog dashboard (/futurise-admin/blog), validated by
# /api/admin-login. NOTE the deliberate absence of a VITE_ prefix — adding one would
# publish it. If unset, the dashboard reports "not configured" and rejects every login.
ADMIN_PASSWORD=

# Optional. HMAC key for signing session cookies; defaults to ADMIN_PASSWORD when unset.
# Set it if you want to rotate the password without ending every active session.
ADMIN_SESSION_SECRET=

# Microsoft Clarity project ID (session recordings, heatmaps, Smart Events, funnels).
# PUBLIC by design — like the GA4 measurement ID, it is visible in the browser and is not
# a secret. Find it in Clarity under Settings > Overview.
#
# Only read in production builds: local development and the prerender pass deliberately
# skip Clarity so they never appear in the dashboard as real sessions. Leaving this unset
# disables Clarity entirely rather than emitting a broken tag.
VITE_CLARITY_PROJECT_ID=
